# SAGE — Agentic Wallet — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Safe contract ─────────────────────────────────────────────────────────────
# Polygon — P2P desk operations (primary)
SAGE_SAFE_ADDRESS=0xYOUR_SAFE_ADDRESS
# Gnosis Chain — treasury/reserve (future)
# SAGE_SAFE_ADDRESS=0xANOTHER_SAFE
# Arbitrum — DeFi ops (future)
# SAGE_SAFE_ADDRESS=0xANOTHER_SAFE

# ── Agent key passphrases ─────────────────────────────────────────────────────
# These unlock the encrypted .sage-key-*.enc files at runtime.
# Use strong, unique passphrases. Back them up securely.
SAGE_PASSPHRASE_COMPLIANCE=change-me-compliance
SAGE_PASSPHRASE_EXECUTION=change-me-execution

# ── Agent key directory (for Docker volume mount) ─────────────────────────────
# Path on the HOST that contains .sage-key-compliance.enc and .sage-key-execution.enc
SAGE_KEYS_DIR=./keys

# ── RPC endpoints (optional overrides) ───────────────────────────────────────
# The code already defaults to these keyless, live endpoints — only set these to
# point at a private/paid node. Do NOT use the old polygon-rpc.com (returns HTTP
# 401 "tenant disabled") or rpc.sepolia.org (Cloudflare 522) — both are dead and
# would override the working defaults.
POLYGON_RPC=https://polygon-bor-rpc.publicnode.com
BASE_RPC=https://mainnet.base.org
ETH_RPC=https://eth.llamarpc.com
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# ── Notifications (for HOLD_HUMAN alerts) ────────────────────────────────────
WHATSAPP_BRIDGE_URL=http://criptografia-p2p:3001/api/bot/send
WHATSAPP_BRIDGE_SECRET=
NOTIFY_PHONE=+5500000000000
