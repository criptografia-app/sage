# SAGE — Agentic Wallet — environment variables
# Copy to .env and fill in values. Never commit .env.

# ── Safe contract ─────────────────────────────────────────────────────────────
SAGE_SAFE_ADDRESS=0xYOUR_SAFE_ADDRESS_HERE

# ── Agent key passphrases ─────────────────────────────────────────────────────
# These unlock the encrypted .sage-key-*.enc files at runtime.
# Use strong, unique passphrases. Back them up securely.
SAGE_PASSPHRASE_COMPLIANCE=change-me-compliance
SAGE_PASSPHRASE_EXECUTION=change-me-execution

# ── Agent key directory (for Docker volume mount) ─────────────────────────────
# Path on the HOST that contains .sage-key-compliance.enc and .sage-key-execution.enc
SAGE_KEYS_DIR=./keys

# ── RPC endpoints (optional overrides) ───────────────────────────────────────
POLYGON_RPC=https://polygon-rpc.com
BASE_RPC=https://mainnet.base.org
ETH_RPC=https://eth.llamarpc.com
SEPOLIA_RPC=https://rpc.sepolia.org

# ── Notifications (for HOLD_HUMAN alerts) ────────────────────────────────────
WHATSAPP_BRIDGE_URL=http://criptografia-p2p:3001/api/bot/send
WHATSAPP_BRIDGE_SECRET=
NOTIFY_PHONE=+5548991703924
