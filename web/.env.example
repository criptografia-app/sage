# SAGE web — Privy social login → agent chat

# Privy app (dashboard.privy.io). The public id reaches the browser and is
# baked at build time; the secret stays server-side to verify login tokens.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Agent services the API route proxies to (compose sets these to service names).
PUBLISHER_URL=http://localhost:3010
SIGNER_URL=http://localhost:3011
